<resources>
    <style name="PulseTheme" parent="android:style/Theme.Material.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="android:colorAccent">#89ABFF</item>
        <item name="android:windowBackground">#161E2C</item>
        <item name="android:statusBarColor">#161E2C</item>
        <item name="android:navigationBarColor">#161E2C</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
        <item name="android:windowActionModeOverlay">true</item>
    </style>
    <style name="PulseThemeDay" parent="android:style/Theme.Material.Light.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="android:colorAccent">#075DB6</item>
        <item name="android:windowBackground">#EFF6FF</item>
        <item name="android:statusBarColor">#DFEEFC</item>
        <item name="android:navigationBarColor">#EFF6FF</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar">true</item>
        <item name="android:windowActionModeOverlay">true</item>
    </style>
    <style name="PulseThemeSystem" parent="@style/PulseThemeDay" />
</resources>
